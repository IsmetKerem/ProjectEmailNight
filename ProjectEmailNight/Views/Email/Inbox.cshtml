@model ProjectEmailNight.Models.EmailListViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "Gelen Kutusu";
    ViewData["PageTitle"] = ViewData["PageTitle"] ?? "Gelen Kutusu";
    var isTrash = Model.CurrentFolder == "trash";
}

<section class="inbox-layout" aria-label="Gelen kutusu düzeni">
    <!-- Sol Sidebar -->
    <aside class="inbox-sidebar">
        <div class="inbox-sidebar__compose">
            <a asp-controller="Email" asp-action="Compose" class="btn btn--compose">
                <i class="fa-solid fa-pen"></i>
                <span>Yeni mail</span>
            </a>
        </div>

        <div>
            <p class="sidebar__section-title">Klasörler</p>
            <ul class="inbox-sidebar__folder-list">
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Inbox" 
                       class="inbox-sidebar__link @(Model.CurrentFolder == "inbox" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__link-icon">
                                <i class="fa-solid fa-inbox"></i>
                            </span>
                            <span>Tüm mailler</span>
                        </span>
                        <span class="inbox-sidebar__badge">@ViewBag.TotalInbox</span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Starred"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "starred" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__link-icon">
                                <i class="fa-solid fa-star"></i>
                            </span>
                            <span>Yıldızlı</span>
                        </span>
                        <span class="inbox-sidebar__badge">@Model.StarredCount</span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Sent"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "sent" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__link-icon">
                                <i class="fa-regular fa-paper-plane"></i>
                            </span>
                            <span>Gönderilmiş</span>
                        </span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Drafts"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "drafts" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__link-icon">
                                <i class="fa-regular fa-file-lines"></i>
                            </span>
                            <span>Taslaklar</span>
                        </span>
                        @if(Model.DraftCount > 0)
                        {
                            <span class="inbox-sidebar__badge">@Model.DraftCount</span>
                        }
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Trash" 
                       class="inbox-sidebar__link @(Model.CurrentFolder == "trash" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__link-icon">
                                <i class="fa-regular fa-trash-can"></i>
                            </span>
                            <span>Çöp Kutusu</span>
                        </span>
                        @if(ViewBag.TrashCount != null && ViewBag.TrashCount > 0)
                        {
                            <span class="inbox-sidebar__badge">@ViewBag.TrashCount</span>
                        }
                    </a>
                </li>
            </ul>
        </div>

        <div>
            <p class="sidebar__section-title">Kategoriler</p>
            <ul class="inbox-sidebar__label-list">
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Category" asp-route-id="1" 
                       class="inbox-sidebar__link @(Model.CurrentFolder == "category-1" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__label-dot" style="background-color: #4285F4;"></span>
                            <span>Birincil</span>
                        </span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Category" asp-route-id="2"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "category-2" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__label-dot" style="background-color: #34A853;"></span>
                            <span>Sosyal</span>
                        </span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Category" asp-route-id="3"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "category-3" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__label-dot" style="background-color: #FBBC05;"></span>
                            <span>Promosyon</span>
                        </span>
                    </a>
                </li>
                <li class="inbox-sidebar__item">
                    <a asp-controller="Email" asp-action="Category" asp-route-id="4"
                       class="inbox-sidebar__link @(Model.CurrentFolder == "category-4" ? "inbox-sidebar__link--active" : "")">
                        <span class="inbox-sidebar__link-left">
                            <span class="inbox-sidebar__label-dot" style="background-color: #EA4335;"></span>
                            <span>İş</span>
                        </span>
                    </a>
                </li>
            </ul>
        </div>
    </aside>

    <!-- Mail Listesi -->
    <section class="inbox-main" aria-label="Mail listesi">
        
        @* Arama sonucu banner'ı *@
        @if(Model.CurrentFolder == "search" && ViewBag.SearchQuery != null)
        {
            <div class="inbox-banner inbox-banner--search">
                <div>
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <span>"<strong>@ViewBag.SearchQuery</strong>" için @Model.TotalCount sonuç bulundu</span>
                </div>
                <a asp-controller="Email" asp-action="Inbox" class="btn btn--secondary btn--sm">
                    <i class="fa-solid fa-xmark"></i>
                    <span>Aramayı Temizle</span>
                </a>
            </div>
        }

        @* Çöp kutusu banner'ı *@
        @if(isTrash)
        {
            <div class="inbox-banner inbox-banner--trash">
                <div>
                    <i class="fa-solid fa-trash-can"></i>
                    <span>Çöp kutusundaki e-postalar <strong>30 gün</strong> sonra otomatik silinir</span>
                </div>
                @if(Model.Emails.Any())
                {
                    <button type="button" class="btn btn--danger btn--sm" onclick="emptyTrash()">
                        <i class="fa-solid fa-trash"></i>
                        <span>Çöp Kutusunu Boşalt</span>
                    </button>
                }
            </div>
        }

        <header class="inbox-main__toolbar">
            <div class="inbox-main__toolbar-left">
                <input type="checkbox" class="inbox-main__checkbox" aria-label="Tüm mailleri seç" id="selectAll">
                <button class="btn btn--ghost" type="button" onclick="location.reload()" title="Yenile">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
                
                @* Bulk Actions *@
                <div class="bulk-actions" id="bulk-actions" style="display: none;">
                    @if(isTrash)
                    {
                        <button class="btn btn--ghost" type="button" onclick="bulkRestore()" title="Geri yükle">
                            <i class="fa-solid fa-rotate-left"></i>
                        </button>
                        <button class="btn btn--ghost btn--ghost-danger" type="button" onclick="bulkPermanentDelete()" title="Kalıcı sil">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    }
                    else
                    {
                        <button class="btn btn--ghost" type="button" onclick="bulkDelete()" title="Çöp kutusuna taşı">
                            <i class="fa-regular fa-trash-can"></i>
                        </button>
                        <button class="btn btn--ghost" type="button" onclick="bulkMarkAsRead()" title="Okundu işaretle">
                            <i class="fa-solid fa-envelope-open"></i>
                        </button>
                        <button class="btn btn--ghost" type="button" onclick="bulkStar()" title="Yıldızla">
                            <i class="fa-regular fa-star"></i>
                        </button>
                    }
                    <span class="bulk-count u-text-muted" id="bulk-count"></span>
                </div>
            </div>
            <div class="inbox-main__toolbar-right">
                <span class="u-text-muted" style="font-size: 0.8rem">
                    @if(Model.TotalCount > 0)
                    {
                        @((Model.CurrentPage - 1) * Model.PageSize + 1)<text>–</text>@(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)) <text>/</text> @Model.TotalCount
                    }
                    else
                    {
                        <text>0 / 0</text>
                    }
                </span>
                
                @* Pagination *@
                @{
                    var prevDisabled = Model.CurrentPage <= 1;
                    var nextDisabled = Model.CurrentPage >= Model.TotalPages;
                }
                
                @if(!prevDisabled)
                {
                    @if(Model.CurrentFolder == "search")
                    {
                        <a asp-action="Search" asp-route-q="@ViewBag.SearchQuery" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    }
                    else if(Model.CurrentFolder == "trash")
                    {
                        <a asp-action="Trash" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    }
                    else if(Model.CurrentFolder.StartsWith("category-"))
                    {
                        var catId = Model.CurrentFolder.Replace("category-", "");
                        <a asp-action="Category" asp-route-id="@catId" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-action="@Model.CurrentFolder" asp-route-page="@(Model.CurrentPage - 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-left"></i>
                        </a>
                    }
                }
                else
                {
                    <button class="btn btn--ghost" disabled><i class="fa-solid fa-chevron-left"></i></button>
                }
                
                @if(!nextDisabled)
                {
                    @if(Model.CurrentFolder == "search")
                    {
                        <a asp-action="Search" asp-route-q="@ViewBag.SearchQuery" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else if(Model.CurrentFolder == "trash")
                    {
                        <a asp-action="Trash" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else if(Model.CurrentFolder.StartsWith("category-"))
                    {
                        var catId = Model.CurrentFolder.Replace("category-", "");
                        <a asp-action="Category" asp-route-id="@catId" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                    else
                    {
                        <a asp-action="@Model.CurrentFolder" asp-route-page="@(Model.CurrentPage + 1)" class="btn btn--ghost">
                            <i class="fa-solid fa-chevron-right"></i>
                        </a>
                    }
                }
                else
                {
                    <button class="btn btn--ghost" disabled><i class="fa-solid fa-chevron-right"></i></button>
                }
            </div>
        </header>

        <div class="inbox-main__table-wrapper">
            @if(Model.Emails.Any())
            {
                <table class="inbox-main__table">
                    <thead class="inbox-main__thead">
                        <tr>
                            <th style="width: 40px"></th>
                            <th style="width: 40px"></th>
                            <th>@(Model.CurrentFolder == "sent" ? "Alıcı" : "Gönderen")</th>
                            <th>Konu</th>
                            <th>Kategori</th>
                            <th style="text-align: right">Tarih</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var email in Model.Emails)
                        {
                            var rowClass = !email.IsRead ? "inbox-main__row inbox-main__row--unread" : "inbox-main__row";
                            var detailUrl = Url.Action("Detail", "Email", new { id = email.Id, from = Model.CurrentFolder });
                            <tr class="@rowClass" data-email-id="@email.Id" onclick="window.location='@detailUrl'">
                                <td class="inbox-main__cell" onclick="event.stopPropagation()">
                                    <input type="checkbox" class="inbox-main__checkbox email-checkbox" data-id="@email.Id">
                                </td>
                                <td class="inbox-main__cell" onclick="event.stopPropagation()">
                                    <button type="button" class="star-btn" data-id="@email.Id" style="background: none; border: none; cursor: pointer;">
                                        <i class="@(email.IsStarred ? "fa-solid" : "fa-regular") fa-star inbox-main__star @(email.IsStarred ? "inbox-main__star--active" : "")"
                                           aria-label="@(email.IsStarred ? "Yıldızlı" : "Yıldızsız")"></i>
                                    </button>
                                </td>
                                <td class="inbox-main__cell">
                                    @if(!email.IsRead)
                                    {
                                        <strong>@(Model.CurrentFolder == "sent" ? email.ReceiverName : email.SenderName)</strong>
                                    }
                                    else
                                    {
                                        @(Model.CurrentFolder == "sent" ? email.ReceiverName : email.SenderName)
                                    }
                                </td>
                                <td class="inbox-main__cell inbox-main__subject">
                                    @if(!email.IsRead)
                                    {
                                        <strong>@email.Subject</strong>
                                    }
                                    else
                                    {
                                        @email.Subject
                                    }
                                    @if(email.HasAttachment)
                                    {
                                        <i class="fa-solid fa-paperclip" style="margin-left: 0.5rem; color: #6b7280;"></i>
                                    }
                                </td>
                                <td class="inbox-main__cell">
                                    @if(!string.IsNullOrEmpty(email.CategoryName))
                                    {
                                        var categoryClass = email.CategoryId switch
                                        {
                                            1 => "inbox-main__category--primary",
                                            2 => "inbox-main__category--success",
                                            3 => "inbox-main__category--warning",
                                            4 => "inbox-main__category--danger",
                                            _ => "inbox-main__category--secondary"
                                        };
                                        <span class="inbox-main__category @categoryClass">
                                            @email.CategoryName
                                        </span>
                                    }
                                </td>
                                <td class="inbox-main__cell" style="text-align: right">
                                    @{
                                        var now = DateTime.UtcNow;
                                        var diff = now - email.CreatedAt;
                                        string dateText;
                                        
                                        if (diff.TotalMinutes < 1)
                                            dateText = "Şimdi";
                                        else if (diff.TotalHours < 1)
                                            dateText = $"{(int)diff.TotalMinutes} dk önce";
                                        else if (email.CreatedAt.Date == now.Date)
                                            dateText = email.CreatedAt.ToString("HH:mm");
                                        else if (email.CreatedAt.Date == now.Date.AddDays(-1))
                                            dateText = "Dün";
                                        else if (diff.TotalDays < 7)
                                            dateText = email.CreatedAt.ToString("dddd", new System.Globalization.CultureInfo("tr-TR"));
                                        else
                                            dateText = email.CreatedAt.ToString("dd MMM");
                                    }
                                    @dateText
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="inbox-empty">
                    @if(Model.CurrentFolder == "search")
                    {
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <p>Aramanızla eşleşen e-posta bulunamadı</p>
                        <span class="u-text-muted">Farklı anahtar kelimeler deneyin</span>
                    }
                    else if(isTrash)
                    {
                        <i class="fa-regular fa-trash-can"></i>
                        <p>Çöp kutusu boş</p>
                        <span class="u-text-muted">Silinen e-postalar burada görünür</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-inbox"></i>
                        <p>Bu klasörde e-posta yok</p>
                    }
                </div>
            }
        </div>
    </section>
</section>

@section Styles {
<style>
    .inbox-banner {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #1f2937;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.9rem;
    }
    
    .inbox-banner > div {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .inbox-banner--search {
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.15), rgba(236, 72, 153, 0.1));
    }
    
    .inbox-banner--search i {
        color: #a78bfa;
    }
    
    .inbox-banner--trash {
        background: linear-gradient(135deg, rgba(239, 68, 68, 0.15), rgba(220, 38, 38, 0.1));
    }
    
    .inbox-banner--trash i {
        color: #ef4444;
    }
    
    .inbox-empty {
        text-align: center;
        padding: 4rem 2rem;
        color: #6b7280;
    }
    
    .inbox-empty i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
    
    .inbox-empty p {
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
    }
    
    .bulk-actions {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-left: 0.5rem;
        padding-left: 0.5rem;
        border-left: 1px solid #374151;
    }
    
    .bulk-count {
        font-size: 0.8rem;
        margin-left: 0.5rem;
    }
    
    .btn--ghost-danger:hover {
        color: #ef4444 !important;
        background-color: rgba(239, 68, 68, 0.1) !important;
    }
    
    .btn--danger {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        border: none;
    }
    
    .btn--danger:hover {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
    }
</style>
}

@section Scripts {
<script>
    var isTrash = @(isTrash ? "true" : "false");
    
    // Yıldız toggle
    document.querySelectorAll('.star-btn').forEach(btn => {
        btn.addEventListener('click', async function(e) {
            e.preventDefault();
            const id = this.dataset.id;
            const icon = this.querySelector('i');
            
            try {
                const response = await fetch('@Url.Action("ToggleStar", "Email")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${id}`
                });
                
                const result = await response.json();
                if (result.success) {
                    icon.classList.toggle('fa-solid');
                    icon.classList.toggle('fa-regular');
                    icon.classList.toggle('inbox-main__star--active');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        });
    });

    // Seçili ID'leri al
    function getSelectedIds() {
        const checkboxes = document.querySelectorAll('.email-checkbox:checked');
        return Array.from(checkboxes).map(cb => parseInt(cb.dataset.id));
    }

    // Bulk actions göster/gizle
    function updateBulkActions() {
        const selected = getSelectedIds();
        const bulkActions = document.getElementById('bulk-actions');
        const bulkCount = document.getElementById('bulk-count');
        
        if (selected.length > 0) {
            bulkActions.style.display = 'flex';
            bulkCount.textContent = selected.length + ' seçili';
        } else {
            bulkActions.style.display = 'none';
        }
    }

    // Checkbox değişikliklerini dinle
    document.querySelectorAll('.email-checkbox').forEach(cb => {
        cb.addEventListener('change', updateBulkActions);
    });

    // Tümünü seç
    document.getElementById('selectAll')?.addEventListener('change', function() {
        document.querySelectorAll('.email-checkbox').forEach(cb => {
            cb.checked = this.checked;
        });
        updateBulkActions();
    });

    // Toplu çöpe taşı
    async function bulkDelete() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;
        
        if (!confirm(ids.length + ' e-postayı çöp kutusuna taşımak istediğinize emin misiniz?')) return;
        
        try {
            const response = await fetch('@Url.Action("BulkDelete", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
            const result = await response.json();
            if (result.success) location.reload();
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Toplu okundu yap
    async function bulkMarkAsRead() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;
        
        try {
            const response = await fetch('@Url.Action("BulkMarkAsRead", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
            const result = await response.json();
            if (result.success) location.reload();
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Toplu yıldızla
    async function bulkStar() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;
        
        try {
            const response = await fetch('@Url.Action("BulkStar", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
            const result = await response.json();
            if (result.success) location.reload();
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Toplu geri yükle
    async function bulkRestore() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;
        
        try {
            const response = await fetch('@Url.Action("BulkRestore", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
            const result = await response.json();
            if (result.success) location.reload();
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Toplu kalıcı sil
    async function bulkPermanentDelete() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;
        
        if (!confirm(ids.length + ' e-postayı kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz!')) return;
        
        try {
            const response = await fetch('@Url.Action("BulkPermanentDelete", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(ids)
            });
            const result = await response.json();
            if (result.success) location.reload();
        } catch (error) {
            console.error('Error:', error);
        }
    }

    // Çöp kutusunu boşalt
    async function emptyTrash() {
        if (!confirm('Çöp kutusundaki TÜM e-postalar kalıcı olarak silinecek. Bu işlem geri alınamaz! Emin misiniz?')) return;
        
        try {
            const response = await fetch('@Url.Action("EmptyTrash", "Email")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
            });
            const result = await response.json();
            if (result.success) {
                alert(result.count + ' e-posta kalıcı olarak silindi.');
                location.reload();
            }
        } catch (error) {
            console.error('Error:', error);
        }
    }
</script>
}